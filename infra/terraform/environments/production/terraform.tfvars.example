# Copy to terraform.tfvars after verifying the target account.
# Credentials belong in a short-lived AWS session, never in this file.
aws_region     = "us-east-1"
aws_account_id = "000000000000" # Replace with the verified account ID.
existing_admin_ipv4_cidr = "192.0.2.1/32" # Replace with the existing rule, not a new address.
