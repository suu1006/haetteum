{
  "name": "@haetteum/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "pnpm --filter @haetteum/contracts build && pnpm db:generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "pretest": "pnpm --filter @haetteum/contracts build && pnpm db:generate",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "pretest:e2e": "pnpm --filter @haetteum/contracts build && pnpm db:generate",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "tourism:sync": "pnpm build && node dist/tourism/tourism-sync.command.js",
    "tourism:enrich": "pnpm build && node dist/tourism/tourism-sync.command.js --mode=enrich",
    "tourism:enrich-ranked": "pnpm build && node dist/tourism/tourism-sync.command.js --mode=enrich-ranked",
    "tourism:smoke": "pnpm build && node dist/tourism/tourism-smoke.command.js",
    "festival:sync": "pnpm build && node dist/tourism/festival-sync.command.js",
    "ranking:import": "pnpm build && node dist/place-rankings/place-ranking-import.command.js",
    "hotplace:import": "pnpm build && node dist/hot-place-rankings/hot-place-ranking-import.command.js",
    "ranking:backfill-images": "pnpm build && node dist/place-rankings/ranking-image-backfill.command.js",
    "ranking:link-places": "pnpm build && node dist/place-rankings/ranking-place-link.command.js",
    "course:sync": "pnpm build && node dist/place-courses/course-sync.command.js",
    "reels:refresh": "pnpm build && node dist/place-reels/place-reels-refresh.command.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.4",
    "@haetteum/contracts": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/terminus": "11.1.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.1",
    "pg": "8.23.0",
    "prisma": "7.9.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@jest/globals": "30.4.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "30.4.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/../test/set-test-env.ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
