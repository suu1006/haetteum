NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Public API origin for binary images. Match the origin of web NEXT_PUBLIC_API_BASE_URL.
# Defaults: development http://localhost:$API_PORT; production WEB_ORIGIN origin.
UPLOADED_IMAGE_PUBLIC_ORIGIN=http://localhost:4000
DATABASE_URL=postgresql://haetteum:local-development-only@localhost:5432/haetteum
TOUR_API_ENDPOINT=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
TOURISM_SYNC_ENABLED=false
# 두 값 모두 설정하면 관광지 정기 배치 결과를 Notion에 기록합니다.
# 대상 데이터 소스에 연결을 추가하세요. 제목 속성은 ID로 지정합니다.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
# Shared PostgreSQL budget: all TourAPI attempts, including retries (KST day)
TOUR_API_DAILY_LIMIT=1000
TOUR_API_MIN_INTERVAL_MS=1000
# Dedicated pg.Pool used only for TourAPI advisory-lock rate limiting (not Prisma)
TOUR_API_POLICY_POOL_MAX=4
YOUTUBE_API_KEY=
PLACE_REELS_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CHAT_ENABLED=false
CHAT_AWS_REGION=
CHAT_BEDROCK_MODEL_ID=

# Weekly nationwide recommendations (enable after migrations/full sync/storage setup)
WEEKLY_RECOMMENDATIONS_ENABLED=false
WEEKLY_THUMBNAIL_PUBLIC_BASE_URL=http://localhost:4000/uploads/weekly
# WEEKLY_THUMBNAIL_DIR=/persistent/uploads/weekly
