generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// 한국 날짜별 로그인 사용자 챗봇 호출 횟수.
model ChatDailyUsage {
  subjectKey String   @map("subject_key")
  day        DateTime @db.Date
  used       Int      @default(0)

  @@id([subjectKey, day])
  @@index([day])
  @@map("chat_daily_usage")
}

/// Haetteum 서비스에서 노출하는 광역 관광 지역
model TourismRegion {
  /// Haetteum 내부 관광 지역 식별자
  id           String  @id @default(uuid()) @db.Uuid
  /// 웹과 API에서 사용하는 안정적인 영문 지역 식별자
  slug         String  @unique @db.VarChar(32)
  /// 사용자에게 표시하는 지역명
  name         String  @db.VarChar(100)
  /// TourAPI 법정동 시도 코드
  providerCode String  @unique @map("provider_code") @db.VarChar(10)
  /// 메인 화면 지역 필터 표시 순서
  displayOrder Int     @map("display_order")
  /// 서비스에서 지역을 노출할지 여부
  isActive     Boolean @default(true) @map("is_active")

  /// 내부 레코드 생성 시각
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  districts TourismDistrict[]
  places    Place[]

  @@map("tourism_regions")
}

/// TourAPI 법정동 시군구 코드와 광역 관광 지역의 관계
model TourismDistrict {
  /// Haetteum 내부 시군구 식별자
  id           String  @id @default(uuid()) @db.Uuid
  /// 소속 광역 관광 지역 식별자
  regionId     String  @map("region_id") @db.Uuid
  /// TourAPI 법정동 시군구 코드
  providerCode String  @map("provider_code") @db.VarChar(10)
  /// 사용자에게 표시하는 시군구명
  name         String  @db.VarChar(100)
  /// 서비스에서 시군구를 사용할지 여부
  isActive     Boolean @default(true) @map("is_active")

  /// 내부 레코드 생성 시각
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  region TourismRegion @relation(fields: [regionId], references: [id], onDelete: Restrict)
  places Place[]

  @@unique([regionId, providerCode])
  @@index([regionId])
  @@map("tourism_districts")
}

/// TourAPI에서 동기화한 관광지 기본 정보
model Place {
  /// Haetteum 내부 관광지 식별자
  id            String @id @default(uuid()) @db.Uuid
  /// 관광지 원본 provider 식별자
  source        String @db.VarChar(32)
  /// provider가 부여한 관광지 식별자
  externalId    String @map("external_id") @db.VarChar(64)
  /// TourAPI 콘텐츠 타입 ID
  contentTypeId Int    @map("content_type_id")

  /// 소속 광역 관광 지역 식별자
  regionId   String  @map("region_id") @db.Uuid
  /// 소속 시군구 식별자이며 제공되지 않으면 NULL
  districtId String? @map("district_id") @db.Uuid

  /// 관광지명
  title     String   @db.VarChar(500)
  /// 기본 주소
  address1  String?  @db.VarChar(500)
  /// 상세 주소
  address2  String?  @db.VarChar(500)
  /// 우편번호
  zipcode   String?  @db.VarChar(20)
  /// WGS84 경도
  longitude Decimal? @db.Decimal(10, 7)
  /// WGS84 위도
  latitude  Decimal? @db.Decimal(10, 7)
  /// TourAPI 지도 확대 레벨
  mapLevel  Int?     @map("map_level")

  /// TourAPI 신분류 대분류 코드
  category1          String?   @db.VarChar(20)
  /// TourAPI 신분류 중분류 코드
  category2          String?   @db.VarChar(20)
  /// TourAPI 신분류 소분류 코드
  category3          String?   @db.VarChar(20)
  /// 관광지 안내 전화번호
  telephone          String?   @db.VarChar(100)
  /// 관광지 홈페이지 주소
  homepage           String?   @db.Text
  /// 관광지 소개 설명
  overview           String?   @db.Text
  /// 관광지 안내센터 정보
  infoCenter         String?   @map("info_center") @db.Text
  /// 관광지 휴무일 안내
  restDate           String?   @map("rest_date") @db.Text
  /// 관광지 이용 가능 계절
  useSeason          String?   @map("use_season") @db.Text
  /// 관광지 이용 시간
  useTime            String?   @map("use_time") @db.Text
  /// 관광지 주차 안내
  parking            String?   @db.Text
  /// 관광지 체험 가능 연령
  experienceAgeRange String?   @map("experience_age_range") @db.Text
  /// 관광지 체험 안내
  experienceGuide    String?   @map("experience_guide") @db.Text
  /// 유모차 대여 가능 여부
  babyCarriage       String?   @map("baby_carriage") @db.Text
  /// 신용카드 사용 가능 여부
  creditCard         String?   @map("credit_card") @db.Text
  /// 반려동물 동반 가능 여부
  pet                String?   @db.Text
  /// TourAPI 상세정보를 마지막으로 정상 반영한 시각
  detailSourceModifiedAt DateTime? @map("detail_source_modified_at") @db.Timestamptz(3)
  detailSyncedAt     DateTime? @map("detail_synced_at") @db.Timestamptz(3)
  /// 관광지 릴스를 YouTube에서 마지막으로 수집 시도한 시각
  reelsSyncedAt      DateTime? @map("reels_synced_at") @db.Timestamptz(3)

  /// 대표 원본 이미지 URL
  primaryImageUrl     String?   @map("primary_image_url") @db.Text
  /// 대표 썸네일 이미지 URL
  primaryThumbnailUrl String?   @map("primary_thumbnail_url") @db.Text
  /// 대표 이미지 공공누리 저작권 유형
  imageCopyrightType  String?   @map("image_copyright_type") @db.VarChar(20)
  /// provider 콘텐츠 최초 등록 시각
  providerCreatedAt   DateTime? @map("provider_created_at") @db.Timestamptz(3)
  /// provider 콘텐츠 최종 수정 시각
  providerModifiedAt  DateTime  @map("provider_modified_at") @db.Timestamptz(3)
  /// 서비스에서 관광지를 노출할지 여부
  isVisible           Boolean   @default(true) @map("is_visible")
  /// 내부 DB에 마지막으로 정상 반영한 시각
  lastSyncedAt        DateTime  @map("last_synced_at") @db.Timestamptz(3)
  /// 내부 레코드 생성 시각
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  region           TourismRegion     @relation(fields: [regionId], references: [id], onDelete: Restrict)
  district         TourismDistrict?  @relation(fields: [districtId], references: [id], onDelete: SetNull)
  rankings         PlaceRanking[]
  hotPlaceRankings HotPlaceRanking[]
  images           PlaceImage[]
  detailInfos      PlaceDetailInfo[]
  reviews          Review[]
  reels            PlaceReel[]
  courseStops      TourCourseStop[]
  favorites        PlaceFavorite[]
  savedCourseStops SavedCourseStop[]

  @@unique([source, externalId])
  @@index([regionId, isVisible])
  @@index([districtId, isVisible])
  @@index([contentTypeId, isVisible])
  @@index([providerModifiedAt])
  @@map("places")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String    @db.VarChar(32)
  providerUserId    String    @map("provider_user_id") @db.VarChar(191)
  displayName       String    @map("display_name") @db.VarChar(100)
  profileImageUrl   String?   @map("profile_image_url") @db.Text
  /// 이메일/비밀번호 로그인용 이메일(소문자 정규화). OAuth 전용 사용자는 NULL
  email             String?   @unique @db.VarChar(255)
  /// 이메일/비밀번호 로그인용 비밀번호 해시. OAuth 전용 사용자는 NULL
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  /// 프로필에서 선택한 여행 스타일 태그(고정 목록, TravelStyle 값)
  travelStyles      String[]  @default([]) @map("travel_styles")
  /// 관심 지역 태그(PlaceRegion 값과 동일한 목록)
  interestedRegions String[]  @default([]) @map("interested_regions")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  reviews      Review[]
  sessions     Session[]
  favorites    PlaceFavorite[]
  savedCourses SavedCourse[]

  @@unique([provider, providerUserId])
  @@map("users")
}

/// 이메일 회원가입 진행 중(이메일 인증 대기) 상태를 임시로 보관. 인증에 성공하면 users로 승격되고 삭제됨
model PendingEmailSignup {
  id            String   @id @default(uuid()) @db.Uuid
  /// 가입 시도 이메일(소문자 정규화, 재요청 시 같은 행을 갱신)
  email         String   @unique @db.VarChar(255)
  /// bcrypt로 해시된 비밀번호. 인증 성공 시 그대로 users.password_hash로 이전
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  /// 인증번호(6자리)의 SHA-256 해시. 평문 인증번호는 저장하지 않음
  codeHash      String   @map("code_hash") @db.VarChar(64)
  /// 인증번호 만료 시각
  codeExpiresAt DateTime @map("code_expires_at") @db.Timestamptz(3)
  /// 인증번호 오답 시도 횟수(과다 시도 시 재요청 유도)
  attempts      Int      @default(0) @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([codeExpiresAt])
  @@map("pending_email_signups")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@map("sessions")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  rating    Int      @db.SmallInt
  title     String   @db.VarChar(30)
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  place  Place         @relation(fields: [placeId], references: [id], onDelete: Restrict)
  images ReviewImage[]

  @@unique([userId, placeId])
  @@index([userId, updatedAt])
  @@index([placeId])
  @@map("reviews")
}

/// 후기에 첨부된 사진 (최대 5장, 작성 순서대로 sortOrder 저장)
model ReviewImage {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  url       String   @db.Text
  sortOrder Int      @map("sort_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder])
  @@map("review_images")
}

/// 사용자가 찜한 관광지
model PlaceFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId, createdAt])
  @@index([placeId])
  @@map("place_favorites")
}

/// 사용자가 저장한 즉석 생성 코스(관광지 근처 명소·카페·맛집 동선)
model SavedCourse {
  /// Haetteum 내부 저장 코스 식별자
  id        String   @id @default(uuid()) @db.Uuid
  /// 저장한 사용자 식별자
  userId    String   @map("user_id") @db.Uuid
  /// 코스 제목(예: "OO 근처 코스")
  title     String   @db.VarChar(500)
  /// 내부 레코드 생성 시각
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops SavedCourseStop[]

  @@index([userId, createdAt])
  @@map("saved_courses")
}

/// 저장된 코스를 구성하는 경유지 스냅샷
model SavedCourseStop {
  /// Haetteum 내부 저장 경유지 식별자
  id             String   @id @default(uuid()) @db.Uuid
  /// 소속 저장 코스 식별자
  savedCourseId  String   @map("saved_course_id") @db.Uuid
  /// 코스 내 방문 순서이며 1부터 시작한다
  sequence       Int
  /// 경유지 역할(anchor/attraction/cafe/restaurant)
  role           String   @db.VarChar(20)
  /// 내부 관광지와 연결되면 그 식별자이며 아니면 NULL(카카오 로컬 POI)
  placeId        String?  @map("place_id") @db.Uuid
  /// 경유지명
  title          String   @db.VarChar(500)
  /// 카카오 카테고리 표시명
  categoryLabel  String?  @map("category_label") @db.VarChar(200)
  /// 경유지 주소
  address        String?  @db.VarChar(500)
  /// WGS84 경도
  longitude      Decimal  @db.Decimal(10, 7)
  /// WGS84 위도
  latitude       Decimal  @db.Decimal(10, 7)
  /// 시작지 대비 직선거리(m)
  distanceMeters Int?     @map("distance_meters")
  /// 카카오 플레이스 상세 URL
  placeUrl       String?  @map("place_url") @db.Text
  /// 내부 레코드 생성 시각
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  savedCourse SavedCourse @relation(fields: [savedCourseId], references: [id], onDelete: Cascade)
  place       Place?      @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@unique([savedCourseId, sequence])
  @@index([placeId])
  @@map("saved_course_stops")
}

/// TourAPI에서 동기화한 관광지 상세 이미지
model PlaceImage {
  /// Haetteum 내부 관광지 이미지 식별자
  id            String   @id @default(uuid()) @db.Uuid
  /// 소속 관광지 식별자
  placeId       String   @map("place_id") @db.Uuid
  /// 이미지 원본 provider 식별자
  source        String   @db.VarChar(32)
  /// provider 이미지 일련번호
  serialNumber  String   @map("serial_number") @db.VarChar(64)
  /// provider 이미지명
  name          String?  @db.VarChar(500)
  /// 원본 이미지 URL
  originalUrl   String   @map("original_url") @db.Text
  /// 썸네일 이미지 URL
  thumbnailUrl  String?  @map("thumbnail_url") @db.Text
  /// 이미지 공공누리 저작권 유형
  copyrightType String?  @map("copyright_type") @db.VarChar(20)
  /// 상세 화면 이미지 표시 순서
  displayOrder  Int      @map("display_order")
  /// 내부 레코드 생성 시각
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, source, serialNumber])
  @@index([placeId, displayOrder])
  @@map("place_images")
}

/// TourAPI에서 동기화한 관광지 반복 상세정보
model PlaceDetailInfo {
  /// Haetteum 내부 반복 상세정보 식별자
  id           String   @id @default(uuid()) @db.Uuid
  /// 소속 관광지 식별자
  placeId      String   @map("place_id") @db.Uuid
  /// 상세정보 원본 provider 식별자
  source       String   @db.VarChar(32)
  /// provider 상세정보 일련번호
  serialNumber String   @map("serial_number") @db.VarChar(64)
  /// provider 상세정보 필드 그룹
  fieldGroup   String?  @map("field_group") @db.VarChar(32)
  /// 상세정보 이름
  name         String   @db.VarChar(500)
  /// 상세정보 본문
  text         String   @db.Text
  /// 상세 화면 표시 순서
  displayOrder Int      @map("display_order")
  /// 내부 레코드 생성 시각
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, source, serialNumber])
  @@index([placeId, displayOrder])
  @@map("place_detail_infos")
}

/// 한국관광 데이터랩 공식 다운로드에서 적재한 기간·대상별 인기관광지 순위
model PlaceRanking {
  /// Haetteum 내부 순위 레코드 식별자
  id                  String   @id @default(uuid()) @db.Uuid
  /// 순위 원본 provider 식별자
  source              String   @db.VarChar(32)
  /// 전국 등 순위 집계 범위
  scope               String   @db.VarChar(32)
  /// 데이터랩 관광지 식별자
  sourcePlaceId       String   @map("source_place_id") @db.VarChar(64)
  /// 데이터랩 관광지명
  sourcePlaceName     String   @map("source_place_name") @db.VarChar(500)
  /// 데이터랩 관광지 구분
  sourceCategory      String   @map("source_category") @db.VarChar(100)
  /// 전체 또는 세대별 집계 대상
  audience            String   @db.VarChar(32)
  /// 순위 집계 시작일
  periodStart         DateTime @map("period_start") @db.Date
  /// 순위 집계 종료일
  periodEnd           DateTime @map("period_end") @db.Date
  /// 집계 범위 안의 원본 순위
  rank                Int
  /// 데이터랩 원본 비율의 퍼센트 값
  sharePercent        Decimal  @map("share_percent") @db.Decimal(5, 2)
  /// 매칭된 Haetteum 관광지 식별자
  placeId             String?  @map("place_id") @db.Uuid
  /// 랭킹 노출용 대표 이미지 URL이며 매칭된 관광지 또는 TourAPI 키워드 검색에서 확정
  primaryImageUrl     String?  @map("primary_image_url") @db.Text
  /// 대표 이미지 공공누리 저작권 유형
  imageCopyrightType  String?  @map("image_copyright_type") @db.VarChar(20)
  /// TourAPI 밖에서(Wikimedia Commons 등) 가져온 이미지의 저작자 표시 문구
  imageAttribution    String?  @map("image_attribution") @db.Text
  /// imageAttribution 문구가 링크할 출처 페이지 URL
  imageAttributionUrl String?  @map("image_attribution_url") @db.Text
  /// 감사 가능한 원본 CSV 파일명
  sourceFileName      String   @map("source_file_name") @db.VarChar(500)
  /// 순위 스냅샷 적재 시각
  importedAt          DateTime @map("imported_at") @db.Timestamptz(3)
  /// 내부 레코드 생성 시각
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@unique([source, scope, periodStart, periodEnd, audience, rank], map: "place_rankings_snapshot_rank_key")
  @@unique([source, scope, periodStart, periodEnd, audience, sourcePlaceId], map: "place_rankings_snapshot_source_place_id_key")
  @@index([source, scope, audience, periodEnd, rank])
  @@index([placeId])
  @@map("place_rankings")
}

