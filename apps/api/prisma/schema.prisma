generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Haetteum 서비스에서 노출하는 광역 관광 지역
model TourismRegion {
  /// Haetteum 내부 관광 지역 식별자
  id           String  @id @default(uuid()) @db.Uuid
  /// 웹과 API에서 사용하는 안정적인 영문 지역 식별자
  slug         String  @unique @db.VarChar(32)
  /// 사용자에게 표시하는 지역명
  name         String  @db.VarChar(100)
  /// TourAPI 법정동 시도 코드
  providerCode String  @unique @map("provider_code") @db.VarChar(10)
  /// 메인 화면 지역 필터 표시 순서
  displayOrder Int     @map("display_order")
  /// 서비스에서 지역을 노출할지 여부
  isActive     Boolean @default(true) @map("is_active")

  /// 내부 레코드 생성 시각
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  districts TourismDistrict[]
  places    Place[]

  @@map("tourism_regions")
}

/// TourAPI 법정동 시군구 코드와 광역 관광 지역의 관계
model TourismDistrict {
  /// Haetteum 내부 시군구 식별자
  id           String  @id @default(uuid()) @db.Uuid
  /// 소속 광역 관광 지역 식별자
  regionId     String  @map("region_id") @db.Uuid
  /// TourAPI 법정동 시군구 코드
  providerCode String  @map("provider_code") @db.VarChar(10)
  /// 사용자에게 표시하는 시군구명
  name         String  @db.VarChar(100)
  /// 서비스에서 시군구를 사용할지 여부
  isActive     Boolean @default(true) @map("is_active")

  /// 내부 레코드 생성 시각
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  region TourismRegion @relation(fields: [regionId], references: [id], onDelete: Restrict)
  places Place[]

  @@unique([regionId, providerCode])
  @@index([regionId])
  @@map("tourism_districts")
}

/// TourAPI에서 동기화한 관광지 기본 정보
model Place {
  /// Haetteum 내부 관광지 식별자
  id            String @id @default(uuid()) @db.Uuid
  /// 관광지 원본 provider 식별자
  source        String @db.VarChar(32)
  /// provider가 부여한 관광지 식별자
  externalId    String @map("external_id") @db.VarChar(64)
  /// TourAPI 콘텐츠 타입 ID
  contentTypeId Int    @map("content_type_id")

  /// 소속 광역 관광 지역 식별자
  regionId   String  @map("region_id") @db.Uuid
  /// 소속 시군구 식별자이며 제공되지 않으면 NULL
  districtId String? @map("district_id") @db.Uuid

  /// 관광지명
  title     String   @db.VarChar(500)
  /// 기본 주소
  address1  String?  @db.VarChar(500)
  /// 상세 주소
  address2  String?  @db.VarChar(500)
  /// 우편번호
  zipcode   String?  @db.VarChar(20)
  /// WGS84 경도
  longitude Decimal? @db.Decimal(10, 7)
  /// WGS84 위도
  latitude  Decimal? @db.Decimal(10, 7)
  /// TourAPI 지도 확대 레벨
  mapLevel  Int?     @map("map_level")

  /// TourAPI 신분류 대분류 코드
  category1 String? @db.VarChar(20)
  /// TourAPI 신분류 중분류 코드
  category2 String? @db.VarChar(20)
  /// TourAPI 신분류 소분류 코드
  category3 String? @db.VarChar(20)
  /// 관광지 안내 전화번호
  telephone String? @db.VarChar(100)
  /// 관광지 홈페이지 주소
  homepage  String? @db.Text
  /// 관광지 소개 설명
  overview  String? @db.Text
  /// 관광지 안내센터 정보
  infoCenter         String?   @map("info_center") @db.Text
  /// 관광지 휴무일 안내
  restDate           String?   @map("rest_date") @db.Text
  /// 관광지 이용 가능 계절
  useSeason          String?   @map("use_season") @db.Text
  /// 관광지 이용 시간
  useTime            String?   @map("use_time") @db.Text
  /// 관광지 주차 안내
  parking            String?   @db.Text
  /// 관광지 체험 가능 연령
  experienceAgeRange String?   @map("experience_age_range") @db.Text
  /// 관광지 체험 안내
  experienceGuide    String?   @map("experience_guide") @db.Text
  /// 유모차 대여 가능 여부
  babyCarriage       String?   @map("baby_carriage") @db.Text
  /// 신용카드 사용 가능 여부
  creditCard         String?   @map("credit_card") @db.Text
  /// 반려동물 동반 가능 여부
  pet                String?   @db.Text
  /// TourAPI 상세정보를 마지막으로 정상 반영한 시각
  detailSyncedAt     DateTime? @map("detail_synced_at") @db.Timestamptz(3)
  /// 관광지 릴스를 YouTube에서 마지막으로 수집 시도한 시각
  reelsSyncedAt      DateTime? @map("reels_synced_at") @db.Timestamptz(3)

  /// 대표 원본 이미지 URL
  primaryImageUrl     String?   @map("primary_image_url") @db.Text
  /// 대표 썸네일 이미지 URL
  primaryThumbnailUrl String?   @map("primary_thumbnail_url") @db.Text
  /// 대표 이미지 공공누리 저작권 유형
  imageCopyrightType  String?   @map("image_copyright_type") @db.VarChar(20)
  /// provider 콘텐츠 최초 등록 시각
  providerCreatedAt   DateTime? @map("provider_created_at") @db.Timestamptz(3)
  /// provider 콘텐츠 최종 수정 시각
  providerModifiedAt  DateTime  @map("provider_modified_at") @db.Timestamptz(3)
  /// 서비스에서 관광지를 노출할지 여부
  isVisible           Boolean   @default(true) @map("is_visible")
  /// 내부 DB에 마지막으로 정상 반영한 시각
  lastSyncedAt        DateTime  @map("last_synced_at") @db.Timestamptz(3)
  /// 내부 레코드 생성 시각
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  region   TourismRegion    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  district TourismDistrict? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  rankings PlaceRanking[]
  images PlaceImage[]
  detailInfos PlaceDetailInfo[]
  reviews Review[]
  reels PlaceReel[]

  @@unique([source, externalId])
  @@index([regionId, isVisible])
  @@index([districtId, isVisible])
  @@index([contentTypeId, isVisible])
  @@index([providerModifiedAt])
  @@map("places")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String    @db.VarChar(32)
  providerUserId  String    @map("provider_user_id") @db.VarChar(191)
  displayName     String    @map("display_name") @db.VarChar(100)
  profileImageUrl String?   @map("profile_image_url") @db.Text
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  reviews  Review[]
  sessions Session[]

  @@unique([provider, providerUserId])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@map("sessions")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  rating    Int      @db.SmallInt
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@unique([userId, placeId])
  @@index([userId, updatedAt])
  @@index([placeId])
  @@map("reviews")
}

/// TourAPI에서 동기화한 관광지 상세 이미지
model PlaceImage {
  /// Haetteum 내부 관광지 이미지 식별자
  id            String   @id @default(uuid()) @db.Uuid
  /// 소속 관광지 식별자
  placeId       String   @map("place_id") @db.Uuid
  /// 이미지 원본 provider 식별자
  source        String   @db.VarChar(32)
  /// provider 이미지 일련번호
  serialNumber  String   @map("serial_number") @db.VarChar(64)
  /// provider 이미지명
  name          String?  @db.VarChar(500)
  /// 원본 이미지 URL
  originalUrl   String   @map("original_url") @db.Text
  /// 썸네일 이미지 URL
  thumbnailUrl  String?  @map("thumbnail_url") @db.Text
  /// 이미지 공공누리 저작권 유형
  copyrightType String?  @map("copyright_type") @db.VarChar(20)
  /// 상세 화면 이미지 표시 순서
  displayOrder  Int      @map("display_order")
  /// 내부 레코드 생성 시각
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, source, serialNumber])
  @@index([placeId, displayOrder])
  @@map("place_images")
}

/// TourAPI에서 동기화한 관광지 반복 상세정보
model PlaceDetailInfo {
  /// Haetteum 내부 반복 상세정보 식별자
  id           String   @id @default(uuid()) @db.Uuid
  /// 소속 관광지 식별자
  placeId      String   @map("place_id") @db.Uuid
  /// 상세정보 원본 provider 식별자
  source       String   @db.VarChar(32)
  /// provider 상세정보 일련번호
  serialNumber String   @map("serial_number") @db.VarChar(64)
  /// provider 상세정보 필드 그룹
  fieldGroup   String?  @map("field_group") @db.VarChar(32)
  /// 상세정보 이름
  name         String   @db.VarChar(500)
  /// 상세정보 본문
  text         String   @db.Text
  /// 상세 화면 표시 순서
  displayOrder Int      @map("display_order")
  /// 내부 레코드 생성 시각
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, source, serialNumber])
  @@index([placeId, displayOrder])
  @@map("place_detail_infos")
}

/// 한국관광 데이터랩 공식 다운로드에서 적재한 기간·대상별 인기관광지 순위
model PlaceRanking {
  /// Haetteum 내부 순위 레코드 식별자
  id              String   @id @default(uuid()) @db.Uuid
  /// 순위 원본 provider 식별자
  source          String   @db.VarChar(32)
  /// 전국 등 순위 집계 범위
  scope           String   @db.VarChar(32)
  /// 데이터랩 관광지 식별자
  sourcePlaceId   String   @map("source_place_id") @db.VarChar(64)
  /// 데이터랩 관광지명
  sourcePlaceName String   @map("source_place_name") @db.VarChar(500)
  /// 데이터랩 관광지 구분
  sourceCategory  String   @map("source_category") @db.VarChar(100)
  /// 전체 또는 세대별 집계 대상
  audience        String   @db.VarChar(32)
  /// 순위 집계 시작일
  periodStart     DateTime @map("period_start") @db.Date
  /// 순위 집계 종료일
  periodEnd       DateTime @map("period_end") @db.Date
  /// 집계 범위 안의 원본 순위
  rank            Int
  /// 데이터랩 원본 비율의 퍼센트 값
  sharePercent    Decimal  @map("share_percent") @db.Decimal(5, 2)
  /// 매칭된 Haetteum 관광지 식별자
  placeId         String?  @map("place_id") @db.Uuid
  /// 감사 가능한 원본 CSV 파일명
  sourceFileName  String   @map("source_file_name") @db.VarChar(500)
  /// 순위 스냅샷 적재 시각
  importedAt      DateTime @map("imported_at") @db.Timestamptz(3)
  /// 내부 레코드 생성 시각
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@unique([source, scope, periodStart, periodEnd, audience, rank], map: "place_rankings_snapshot_rank_key")
  @@unique([source, scope, periodStart, periodEnd, audience, sourcePlaceId], map: "place_rankings_snapshot_source_place_id_key")
  @@index([source, scope, audience, periodEnd, rank])
  @@index([placeId])
  @@map("place_rankings")
}

/// YouTube Data API에서 수집한 관광지 릴스(세로 숏폼) 캐시
model PlaceReel {
  /// Haetteum 내부 릴스 식별자
  id              String   @id @default(uuid()) @db.Uuid
  /// 소속 관광지 식별자
  placeId         String   @map("place_id") @db.Uuid
  /// 릴스 원본 provider 식별자
  provider        String   @db.VarChar(32)
  /// provider가 부여한 영상 식별자
  providerVideoId String   @map("provider_video_id") @db.VarChar(32)
  /// 영상 제목
  title           String   @db.VarChar(500)
  /// 업로드 채널명
  channelTitle    String   @map("channel_title") @db.VarChar(255)
  /// 세로 썸네일 이미지 URL
  thumbnailUrl    String   @map("thumbnail_url") @db.Text
  /// 영상 길이(초)
  durationSeconds Int      @map("duration_seconds")
  /// 조회수이며 제공되지 않으면 NULL
  viewCount       BigInt?  @map("view_count")
  /// 영상 공개 시각
  publishedAt     DateTime @map("published_at") @db.Timestamptz(3)
  /// 릴스 목록 표시 순서
  displayOrder    Int      @map("display_order")
  /// 릴스를 provider에서 마지막으로 정상 조회한 시각
  fetchedAt       DateTime @map("fetched_at") @db.Timestamptz(3)
  /// 내부 레코드 생성 시각
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, provider, providerVideoId])
  @@index([placeId, displayOrder])
  @@map("place_reels")
}

/// TourAPI에서 동기화한 축제 기본 정보
model Festival {
  /// Haetteum 내부 축제 식별자
  id            String @id @default(uuid()) @db.Uuid
  /// 축제 원본 provider 식별자
  source        String @db.VarChar(32)
  /// provider가 부여한 축제 식별자
  externalId    String @map("external_id") @db.VarChar(64)
  /// TourAPI 콘텐츠 타입 ID
  contentTypeId Int    @map("content_type_id")

  /// 축제명
  title          String   @db.VarChar(500)
  /// 축제 시작일
  eventStartDate DateTime @map("event_start_date") @db.Date
  /// 축제 종료일
  eventEndDate   DateTime @map("event_end_date") @db.Date

  /// TourAPI 법정동 시도 코드
  providerRegionCode   String? @map("provider_region_code") @db.VarChar(10)
  /// TourAPI 법정동 시군구 코드
  providerDistrictCode String? @map("provider_district_code") @db.VarChar(10)

  /// 기본 주소
  address1  String?  @db.VarChar(500)
  /// 상세 주소
  address2  String?  @db.VarChar(500)
  /// 우편번호
  zipcode   String?  @db.VarChar(20)
  /// WGS84 경도
  longitude Decimal? @db.Decimal(10, 7)
  /// WGS84 위도
  latitude  Decimal? @db.Decimal(10, 7)
  /// TourAPI 지도 확대 레벨
  mapLevel  Int?     @map("map_level")

  /// TourAPI 신분류 대분류 코드
  category1 String? @db.VarChar(20)
  /// TourAPI 신분류 중분류 코드
  category2 String? @db.VarChar(20)
  /// TourAPI 신분류 소분류 코드
  category3 String? @db.VarChar(20)
  /// 축제 안내 전화번호
  telephone String? @db.VarChar(100)

  /// 대표 원본 이미지 URL
  primaryImageUrl     String?   @map("primary_image_url") @db.Text
  /// 대표 썸네일 이미지 URL
  primaryThumbnailUrl String?   @map("primary_thumbnail_url") @db.Text
  /// 대표 이미지 공공누리 저작권 유형
  imageCopyrightType  String?   @map("image_copyright_type") @db.VarChar(20)
  /// provider 콘텐츠 최초 등록 시각
  providerCreatedAt   DateTime? @map("provider_created_at") @db.Timestamptz(3)
  /// provider 콘텐츠 최종 수정 시각
  providerModifiedAt  DateTime  @map("provider_modified_at") @db.Timestamptz(3)
  /// 내부 DB에 마지막으로 정상 반영한 시각
  lastSyncedAt        DateTime  @map("last_synced_at") @db.Timestamptz(3)
  /// 내부 레코드 생성 시각
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([source, externalId])
  @@index([eventStartDate, eventEndDate])
  @@index([providerRegionCode, eventStartDate])
  @@index([providerModifiedAt])
  @@map("festivals")
}

/// 관광 데이터 전체 또는 증분 동기화 실행 이력
model TourismSyncRun {
  /// 동기화 실행 식별자
  id            String    @id @default(uuid()) @db.Uuid
  /// 동기화 대상 관광 데이터 provider
  provider      String    @db.VarChar(32)
  /// 전체 또는 증분 등 동기화 작업 유형
  jobType       String    @map("job_type") @db.VarChar(32)
  /// 동기화 실행 상태
  status        String    @db.VarChar(32)
  /// 증분 동기화 요청에 사용한 시작 기준 시각
  requestedFrom DateTime? @map("requested_from") @db.Timestamptz(3)
  /// 동기화 실행 시작 시각
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  /// 동기화 실행 종료 시각
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)

  /// 외부 provider에서 조회한 항목 수
  fetchedCount     Int     @default(0) @map("fetched_count")
  /// 새로 저장한 항목 수
  insertedCount    Int     @default(0) @map("inserted_count")
  /// 기존 값을 갱신한 항목 수
  updatedCount     Int     @default(0) @map("updated_count")
  /// 비표출 상태로 전환한 항목 수
  deactivatedCount Int     @default(0) @map("deactivated_count")
  /// 처리에 실패한 항목 수
  failedCount      Int     @default(0) @map("failed_count")
  /// 비밀정보를 제외한 오류 요약
  errorSummary     String? @map("error_summary") @db.Text

  @@index([provider, status, finishedAt])
  @@map("tourism_sync_runs")
}
