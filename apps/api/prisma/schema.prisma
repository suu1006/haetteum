  /// 매칭된 Haetteum 관광지 식별자
  placeId             String?  @map("place_id") @db.Uuid
  /// 랭킹 노출용 대표 이미지 URL이며 매칭된 관광지 또는 TourAPI 키워드 검색에서 확정
  primaryImageUrl     String?  @map("primary_image_url") @db.Text
  /// 대표 이미지 공공누리 저작권 유형
  imageCopyrightType  String?  @map("image_copyright_type") @db.VarChar(20)
  /// TourAPI 밖에서(Wikimedia Commons 등) 가져온 이미지의 저작자 표시 문구
  imageAttribution    String?  @map("image_attribution") @db.Text
  /// imageAttribution 문구가 링크할 출처 페이지 URL
  imageAttributionUrl String?  @map("image_attribution_url") @db.Text
  /// 감사 가능한 원본 CSV 파일명
  sourceFileName      String   @map("source_file_name") @db.VarChar(500)
  /// 순위 스냅샷 적재 시각
  importedAt          DateTime @map("imported_at") @db.Timestamptz(3)
  /// 내부 레코드 생성 시각
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@unique([source, scope, periodStart, periodEnd, audience, rank], map: "hot_place_rankings_snapshot_rank_key")
  @@unique([source, scope, periodStart, periodEnd, audience, sourcePlaceId], map: "hot_place_rankings_snapshot_source_place_id_key")
  @@index([source, scope, audience, periodEnd, rank])
  @@index([placeId])
  @@map("hot_place_rankings")
}

/// YouTube Data API에서 수집한 관광지 릴스(세로 숏폼) 캐시
model PlaceReel {
  /// Haetteum 내부 릴스 식별자
  id              String   @id @default(uuid()) @db.Uuid
  /// 소속 관광지 식별자
  placeId         String   @map("place_id") @db.Uuid
  /// 릴스 원본 provider 식별자
  provider        String   @db.VarChar(32)
  /// provider가 부여한 영상 식별자
  providerVideoId String   @map("provider_video_id") @db.VarChar(32)
  /// 영상 제목
  title           String   @db.VarChar(500)
  /// 업로드 채널명
  channelTitle    String   @map("channel_title") @db.VarChar(255)
  /// 세로 썸네일 이미지 URL
  thumbnailUrl    String   @map("thumbnail_url") @db.Text
  /// 영상 길이(초)
  durationSeconds Int      @map("duration_seconds")
  /// 조회수이며 제공되지 않으면 NULL
  viewCount       BigInt?  @map("view_count")
  /// 영상 공개 시각
  publishedAt     DateTime @map("published_at") @db.Timestamptz(3)
  /// 릴스 목록 표시 순서
  displayOrder    Int      @map("display_order")
  /// 릴스를 provider에서 마지막으로 정상 조회한 시각
  fetchedAt       DateTime @map("fetched_at") @db.Timestamptz(3)
  /// 내부 레코드 생성 시각
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, provider, providerVideoId])
  @@index([placeId, displayOrder])
  @@map("place_reels")
}

/// TourAPI에서 동기화한 여행코스(contentTypeId=25)
model TourCourse {
  /// Haetteum 내부 여행코스 식별자
  id                 String   @id @default(uuid()) @db.Uuid
  /// 여행코스 원본 provider 식별자
  source             String   @db.VarChar(32)
  /// provider가 부여한 여행코스 식별자
  externalId         String   @map("external_id") @db.VarChar(64)
  /// 여행코스명
  title              String   @db.VarChar(500)
  /// 여행코스 소개 설명
  overview           String?  @db.Text
  /// 코스 총 소요시간 안내 문구
  takeTime           String?  @map("take_time") @db.VarChar(200)
  /// 코스 총 이동거리 안내 문구
  distance           String?  @db.VarChar(200)
  /// 코스 일정 구분
  schedule           String?  @db.VarChar(200)
  /// 코스 테마
  theme              String?  @db.VarChar(200)
  /// 대표 이미지 URL이며 코스 자체 이미지가 없으면 NULL
  primaryImageUrl    String?  @map("primary_image_url") @db.Text
  /// WGS84 경도
  longitude          Decimal? @db.Decimal(10, 7)
  /// WGS84 위도
  latitude           Decimal? @db.Decimal(10, 7)
  /// provider 콘텐츠 최종 수정 시각
  providerModifiedAt DateTime @map("provider_modified_at") @db.Timestamptz(3)
  /// 내부 DB에 마지막으로 정상 반영한 시각
  lastSyncedAt       DateTime @map("last_synced_at") @db.Timestamptz(3)
  /// 내부 레코드 생성 시각
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stops TourCourseStop[]

  @@unique([source, externalId])
  @@map("tour_courses")
}

/// 여행코스를 구성하는 경유지
model TourCourseStop {
  /// Haetteum 내부 경유지 식별자
  id              String   @id @default(uuid()) @db.Uuid
  /// 소속 여행코스 식별자
  courseId        String   @map("course_id") @db.Uuid
  /// 코스 내 방문 순서이며 1부터 시작한다
  sequence        Int
  /// provider가 부여한 경유지 콘텐츠 식별자
  externalPlaceId String   @map("external_place_id") @db.VarChar(64)
  /// 내부 관광지와 연결되면 그 식별자이며 아니면 NULL
  placeId         String?  @map("place_id") @db.Uuid
  /// 경유지명
  title           String   @db.VarChar(500)
  /// 경유지 소개 설명
  overview        String?  @db.Text
  /// 경유지 대표 이미지 URL
  imageUrl        String?  @map("image_url") @db.Text
  /// 내부 레코드 생성 시각
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course TourCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  place  Place?     @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@unique([courseId, sequence])
  @@index([placeId])
  @@index([externalPlaceId])
  @@map("tour_course_stops")
}

/// TourAPI에서 동기화한 축제 기본 정보
model Festival {
  detailSnapshot Json? @map("detail_snapshot")
  detailSourceModifiedAt DateTime? @map("detail_source_modified_at") @db.Timestamptz(3)
  detailSyncedAt DateTime? @map("detail_synced_at") @db.Timestamptz(3)
  /// Haetteum 내부 축제 식별자
  id            String @id @default(uuid()) @db.Uuid
  /// 축제 원본 provider 식별자
  source        String @db.VarChar(32)
  /// provider가 부여한 축제 식별자
  externalId    String @map("external_id") @db.VarChar(64)
  /// TourAPI 콘텐츠 타입 ID
  contentTypeId Int    @map("content_type_id")

  /// 축제명
  title          String   @db.VarChar(500)
  /// 축제 시작일
  eventStartDate DateTime @map("event_start_date") @db.Date
  /// 축제 종료일
  eventEndDate   DateTime @map("event_end_date") @db.Date

  /// TourAPI 법정동 시도 코드
  providerRegionCode   String? @map("provider_region_code") @db.VarChar(10)
  /// TourAPI 법정동 시군구 코드
  providerDistrictCode String? @map("provider_district_code") @db.VarChar(10)

  /// 기본 주소
  address1  String?  @db.VarChar(500)
  /// 상세 주소
  address2  String?  @db.VarChar(500)
  /// 우편번호
  zipcode   String?  @db.VarChar(20)
  /// WGS84 경도
  longitude Decimal? @db.Decimal(10, 7)
  /// WGS84 위도
  latitude  Decimal? @db.Decimal(10, 7)
  /// TourAPI 지도 확대 레벨
  mapLevel  Int?     @map("map_level")

  /// TourAPI 신분류 대분류 코드
  category1 String? @db.VarChar(20)
  /// TourAPI 신분류 중분류 코드
  category2 String? @db.VarChar(20)
  /// TourAPI 신분류 소분류 코드
  category3 String? @db.VarChar(20)
  /// 축제 안내 전화번호
  telephone String? @db.VarChar(100)

  /// provider가 콘텐츠를 계속 제공하는지 여부(비표출 전환 시 false)
  isVisible Boolean @default(true) @map("is_visible")

  /// 대표 원본 이미지 URL
  primaryImageUrl     String?   @map("primary_image_url") @db.Text
  /// 대표 썸네일 이미지 URL
  primaryThumbnailUrl String?   @map("primary_thumbnail_url") @db.Text
  /// 대표 이미지 공공누리 저작권 유형
  imageCopyrightType  String?   @map("image_copyright_type") @db.VarChar(20)
  /// provider 콘텐츠 최초 등록 시각
  providerCreatedAt   DateTime? @map("provider_created_at") @db.Timestamptz(3)
  /// provider 콘텐츠 최종 수정 시각
  providerModifiedAt  DateTime  @map("provider_modified_at") @db.Timestamptz(3)
  /// 내부 DB에 마지막으로 정상 반영한 시각
  lastSyncedAt        DateTime  @map("last_synced_at") @db.Timestamptz(3)
  /// 내부 레코드 생성 시각
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 내부 레코드 최종 수정 시각
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([source, externalId])
  @@index([eventStartDate, eventEndDate])
  @@index([providerRegionCode, eventStartDate])
  @@index([providerModifiedAt])
  @@index([isVisible, eventStartDate])
  @@map("festivals")
}

/// 관광 데이터 전체 또는 증분 동기화 실행 이력
model TourismSyncRun {
  checkpointAt DateTime? @map("checkpoint_at") @db.Timestamptz(3)
  /// 동기화 실행 식별자
  id            String    @id @default(uuid()) @db.Uuid
  /// 동기화 대상 관광 데이터 provider
  provider      String    @db.VarChar(32)
  /// 전체 또는 증분 등 동기화 작업 유형
  jobType       String    @map("job_type") @db.VarChar(32)
  /// 동기화 실행 상태
  status        String    @db.VarChar(32)
  /// 증분 동기화 요청에 사용한 시작 기준 시각
  requestedFrom DateTime? @map("requested_from") @db.Timestamptz(3)
  /// 동기화 실행 시작 시각
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  /// 동기화 실행 종료 시각
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)

  /// 외부 provider에서 조회한 항목 수
  fetchedCount     Int     @default(0) @map("fetched_count")
  /// 새로 저장한 항목 수
  insertedCount    Int     @default(0) @map("inserted_count")
  /// 기존 값을 갱신한 항목 수
  updatedCount     Int     @default(0) @map("updated_count")
  /// 비표출 상태로 전환한 항목 수
  deactivatedCount Int     @default(0) @map("deactivated_count")
  /// 처리에 실패한 항목 수
  failedCount      Int     @default(0) @map("failed_count")
  /// 비밀정보를 제외한 오류 요약
  errorSummary     String? @map("error_summary") @db.Text

  @@index([provider, status, finishedAt])
  @@map("tourism_sync_runs")
}

/// 주차별 추천 초안 및 검증/공개 상태. 공개 전환은 한 트랜잭션으로 수행한다.
model WeeklyRecommendationEdition {
  id String @id @default(uuid()) @db.Uuid
  week DateTime @unique @db.Date
  status String @default("DRAFT") @db.VarChar(20)
  errorCode String? @map("error_code") @db.VarChar(100)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  candidates WeeklyRecommendationCandidate[]
  @@index([status, week])
  @@map("weekly_recommendation_editions")
}

/// 검증 항목과 제외 사유, 준비된 카드 스냅샷을 보존한다.
model WeeklyRecommendationCandidate {
  id String @id @default(uuid()) @db.Uuid
  editionId String @map("edition_id") @db.Uuid
  placeId String @map("place_id") @db.Uuid
  status String @default("PENDING") @db.VarChar(20)
  kind String @db.VarChar(32)
  reason String? @db.VarChar(100)
  checks Json @default("{}")
  snapshot Json
  checkedAt DateTime? @map("checked_at") @db.Timestamptz(3)
  position Int?
  edition WeeklyRecommendationEdition @relation(fields:[editionId],references:[id],onDelete:Cascade)
  @@unique([editionId,placeId])
  @@index([editionId,status,position])
  @@index([placeId])
  @@map("weekly_recommendation_candidates")
}

/// 여러 API 인스턴스의 배치 중복 실행 방지용 만료 가능한 임대.
model WeeklyRecommendationLease {
  name String @id
  token String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@map("weekly_recommendation_leases")
}

/// TourAPI 호출 시도 예산. KST 날짜 기준, 모든 배치/재시도가 공유한다.
model TourApiDailyUsage {
  day DateTime @id @db.Date
  calls Int
  lastStartedAt DateTime @map("last_started_at") @db.Timestamptz(3)
  @@map("tour_api_daily_usage")
}
