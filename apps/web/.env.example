# required
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# optional (지도 컴포넌트에서 Kakao Maps JS SDK를 사용하려면 설정)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 주간 추천 사진 표시에 필요: 해당 API가 반환하는 썸네일의 origin/경로와 일치해야 함
# 운영 API 사용 시 https://haetteum.kr/uploads/weekly (NEXT_PUBLIC 변수이므로 변경 후 재빌드)
NEXT_PUBLIC_WEEKLY_THUMBNAIL_BASE_URL=http://localhost:4000/uploads/weekly
